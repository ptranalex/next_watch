# Next Watch - Local Development Configuration
# Copy this file to .env.local and customize for your environment

#=
# DATABASE CONFIGURATION
#=
# PostgreSQL connection for local development
DATABASE_URL=postgresql://your_username@localhost:5432/next_watch

#=
# SECURITY SETTINGS
#=
# JWT Secret - MUST match across all services
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here-change-in-production

#=
# EXTERNAL API KEYS (OPTIONAL)
#=
# TMDB API Access Token (for data import)
# Get from: https://www.themoviedb.org/settings/api
# TMDB_ACCESS_TOKEN=your-tmdb-access-token-here

# OMDB API Key (for additional movie data)
# Get from: http://www.omdbapi.com/apikey.aspx
# OMDB_API_KEY=your-omdb-api-key-here

#=
# SERVICE CONFIGURATION (Usually defaults are fine)
#=
# REDIS_HOST=localhost
# REDIS_PORT=6379
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
