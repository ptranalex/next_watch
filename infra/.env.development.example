# Development Environment Configuration (example)
# Copy to: infra/.env.development (do not commit) if you want a shared dev env file.
#
# Note: many services also support per-service `.env.local` files (preferred).

# Database URLs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_watch
AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_watch_auth

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET=dev-jwt-secret-key-not-for-production
JWT_ALGORITHM=HS256

# API Keys (Development/Test Keys)
TMDB_ACCESS_TOKEN=your-dev-tmdb-token
OMDB_API_KEY=your-dev-omdb-key

# Logging
LOG_LEVEL=DEBUG
DEBUG=true

# Tracing Configuration - Development
ENABLE_TRACING=true
TRACING_ENDPOINT=http://localhost:4317
TRACING_SAMPLE_RATE=1.0
SERVICE_VERSION=1.0.0-dev

# CORS - Permissive for development
CORS_ORIGINS=http://localhost:3000,http://localhost:8001,http://localhost:8002

# Feature flags - All enabled for development
ENABLE_PERFORMANCE_METRICS=true
ENABLE_ADVANCED_SEARCH=true
ENABLE_RECOMMENDATIONS=true
ENABLE_ML_FEATURES=true
