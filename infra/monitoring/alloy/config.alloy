// Grafana Alloy Configuration for NextWatch Free Tier Migration
// Optimized for 10k metric series limit and 50GB log volume limit

//
// PROMETHEUS METRICS COLLECTION
//

// Grafana Cloud Metrics endpoint
prometheus.remote_write "grafana_cloud_metrics" {
  endpoint {
    url = env("GRAFANA_CLOUD_METRICS_URL")
    basic_auth {
      username = env("GRAFANA_CLOUD_METRICS_USERNAME")
      password = env("GRAFANA_CLOUD_METRICS_PASSWORD")
    }
  }
  
  // Add global labels
  external_labels = {
    cluster = "nextwatch-aws",
    region = "ap-southeast-1",
    instance_id = "i-0c78dddbab78124cb",
    environment = "production",
  }
}

//
// TIER 1: CRITICAL SERVICES (Start with these only)
//

// Backend API - Most critical service
prometheus.scrape "backend_api" {
  targets = [{"__address__" = "backend-api:8000"}]
  scrape_interval = "30s"
  scrape_timeout = "10s"
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

// Universal metric filtering for all services
prometheus.relabel "filter_metrics" {
  forward_to = [prometheus.remote_write.grafana_cloud_metrics.receiver]

  rule {
    source_labels = ["__name__"]
    regex = "(up|http_requests_total|http_request_duration_seconds_bucket|http_request_duration_seconds_sum|http_request_duration_seconds_count|health_status|process_cpu_seconds_total|process_resident_memory_bytes|bff_.*|backend_.*|search_.*|ml_.*|auth_.*|recommendation_.*)"
    action = "keep"
  }
  
  rule {
    source_labels = ["method"]
    regex = "(GET|POST|PUT|DELETE)"
    action = "keep"
  }
  
  rule {
    source_labels = ["status_code"]
    regex = "([2-5][0-9][0-9])"
    action = "keep"
  }
  
  rule {
    regex = "(request_id|trace_id|span_id|user_id|session_id)"
    action = "labeldrop"
  }
}

// BFF API - Critical for user interface
prometheus.scrape "bff_api" {
  targets = [{"__address__" = "bff-api:8000"}]
  scrape_interval = "30s"
  scrape_timeout = "10s" 
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

// Auth API - Critical for authentication
prometheus.scrape "auth_api" {
  targets = [{"__address__" = "auth-api:8000"}]
  scrape_interval = "30s"
  scrape_timeout = "10s"
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

//
// HEALTH MONITORING (Preserve existing 3-tier health system)
//

// Health endpoints monitoring using discovery
discovery.relabel "health_targets" {
  targets = [
    {"__address__" = "backend-api:8000", "__meta_service" = "backend-api"},
    {"__address__" = "bff-api:8000", "__meta_service" = "bff-api"},
    {"__address__" = "auth-api:8000", "__meta_service" = "auth-api"},
    {"__address__" = "search-api:8000", "__meta_service" = "search-api"},
    {"__address__" = "ml-api:8000", "__meta_service" = "ml-api"},
    {"__address__" = "recommendation-api:8000", "__meta_service" = "recommendation-api"},
    {"__address__" = "qdrant:6333", "__meta_service" = "qdrant"},
  ]
  
  rule {
    source_labels = ["__meta_service"]
    target_label = "service"
  }
  
  rule {
    target_label = "environment"
    replacement = "production"
  }
}

// Health endpoint probing
prometheus.scrape "health_check" {
  targets = discovery.relabel.health_targets.output
  scrape_interval = "30s"
  metrics_path = "/health"
  scrape_timeout = "5s"
  
  forward_to = [prometheus.relabel.filter_health.receiver]
}

// Health-specific metric filtering
prometheus.relabel "filter_health" {
  forward_to = [prometheus.remote_write.grafana_cloud_metrics.receiver]

  rule {
    source_labels = ["__name__"]
    regex = "(up|health_.*|probe_.*)"
    action = "keep"
  }
}

//
// TIER 2: SECONDARY SERVICES (All services from docker-compose.prod.yml)
//

// Search API - Dedicated search service
prometheus.scrape "search_api" {
  targets = [{"__address__" = "search-api:8000"}]
  scrape_interval = "60s"  // Less frequent for secondary services
  scrape_timeout = "10s"
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

// ML API - Machine learning service
prometheus.scrape "ml_api" {
  targets = [{"__address__" = "ml-api:8000"}]
  scrape_interval = "60s"
  scrape_timeout = "10s"
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

// Recommendation API - Movie recommendation service
prometheus.scrape "recommendation_api" {
  targets = [{"__address__" = "recommendation-api:8000"}]
  scrape_interval = "60s"
  scrape_timeout = "10s"
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_metrics.receiver]
}

// Qdrant - Vector Database (exposes comprehensive metrics)
prometheus.scrape "qdrant" {
  targets = [{"__address__" = "qdrant:6333"}]
  scrape_interval = "60s"
  scrape_timeout = "10s"
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_qdrant.receiver]
}

// Qdrant-specific metric filtering (different from API services)
prometheus.relabel "filter_qdrant" {
  forward_to = [prometheus.remote_write.grafana_cloud_metrics.receiver]

  rule {
    source_labels = ["__name__"]
    regex = "(app_info|collections_total|collections_vector_total|rest_responses_total|rest_responses_avg_duration_seconds|memory_.*_bytes|collection_hardware_metric_.*)"
    action = "keep"
  }
  
  rule {
    regex = "(request_id|trace_id|span_id|user_id|session_id)"
    action = "labeldrop"
  }
}

//
// USAGE MONITORING (Critical for free tier management)
//

// Self-monitoring to track Alloy performance
prometheus.scrape "alloy_self" {
  targets = [{"__address__" = "localhost:12345"}]
  scrape_interval = "60s"
  metrics_path = "/metrics"
  
  forward_to = [prometheus.relabel.filter_self.receiver]
}

// Self-monitoring metric filtering
prometheus.relabel "filter_self" {
  forward_to = [prometheus.remote_write.grafana_cloud_metrics.receiver]

  rule {
    source_labels = ["__name__"]
    regex = "(alloy_.*|prometheus_.*active_series|prometheus_.*samples_ingested)"
    action = "keep"
  }
}

//
// LOGS COLLECTION (ERROR/WARN only for free tier)
//

// Grafana Cloud Logs endpoint
loki.write "grafana_cloud_logs" {
  endpoint {
    url = env("GRAFANA_CLOUD_LOGS_URL")
    basic_auth {
      username = env("GRAFANA_CLOUD_LOGS_USERNAME") 
      password = env("GRAFANA_CLOUD_LOGS_PASSWORD")
    }
  }
  
  // Add global labels
  external_labels = {
    cluster = "nextwatch-aws",
    environment = "production",
  }
}

// Docker container discovery for logs
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Docker log target relabeling
discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label = "service"
  }
  
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "(backend-api|bff-api|auth-api|search-api|ml-api|recommendation-api|qdrant)"
    action = "keep"
  }
}

// Docker container logs - ERROR/WARN only
loki.source.docker "nextwatch_containers" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.docker_logs.output
  
  forward_to = [loki.process.filter_logs.receiver]
}

// Log processing and filtering
loki.process "filter_logs" {
  // Only keep ERROR and WARN logs
  stage.regex {
    expression = "(?i).*(error|warn|fatal|critical).*"
  }
  
  // Extract log level
  stage.regex {
    expression = "(?i)(?P<level>error|warn|fatal|critical)"
  }
  
  // Add level label
  stage.labels {
    values = {
      level = "",
    }
  }
  
  forward_to = [loki.write.grafana_cloud_logs.receiver]
}

//
// FILE-BASED LOGS (NextWatch service logs)
//

// Backend API logs
loki.source.file "backend_logs" {
  targets = [
    {"__path__" = "/app/logs/backend/*.log", "service" = "backend-api"},
  ]
  forward_to = [loki.process.filter_logs.receiver]
}

// BFF API logs  
loki.source.file "bff_logs" {
  targets = [
    {"__path__" = "/app/logs/bff/*.log", "service" = "bff-api"},
  ]
  forward_to = [loki.process.filter_logs.receiver]
}

// Auth API logs
loki.source.file "auth_logs" {
  targets = [
    {"__path__" = "/app/logs/auth/*.log", "service" = "auth-api"},
  ]
  forward_to = [loki.process.filter_logs.receiver]
}

// Search API logs
loki.source.file "search_logs" {
  targets = [
    {"__path__" = "/app/logs/search/*.log", "service" = "search-api"},
  ]
  forward_to = [loki.process.filter_logs.receiver]
}

// ML API logs
loki.source.file "ml_logs" {
  targets = [
    {"__path__" = "/app/logs/ml/*.log", "service" = "ml-api"},
  ]
  forward_to = [loki.process.filter_logs.receiver]
}

// Recommendation API logs
loki.source.file "recommendation_logs" {
  targets = [
    {"__path__" = "/app/logs/recommendation/*.log", "service" = "recommendation-api"},
  ]
  forward_to = [loki.process.filter_logs.receiver]
}



//
// TRACING COLLECTION (OpenTelemetry)
//

// OTLP receiver for traces (gRPC)
otelcol.receiver.otlp "nextwatch_traces" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  
  http {
    endpoint = "0.0.0.0:4318"
  }
  
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// Batch processor for better performance and reduced API calls
otelcol.processor.batch "default" {
  timeout = "1s"
  send_batch_size = 1024
  send_batch_max_size = 2048
  
  output {
    traces = [otelcol.processor.memory_limiter.default.input]
  }
}

// Memory limiter to prevent OOM issues
otelcol.processor.memory_limiter "default" {
  check_interval = "1s"
  limit = "128MiB"
  
  output {
    traces = [otelcol.exporter.otlp.grafana_cloud_traces.input]
  }
}

// Tempo/Grafana Cloud traces exporter
otelcol.exporter.otlp "grafana_cloud_traces" {
  client {
    endpoint = env("GRAFANA_CLOUD_TRACES_URL")
    auth = otelcol.auth.basic.grafana_cloud_traces.handler
  }
}

// Basic auth for traces
otelcol.auth.basic "grafana_cloud_traces" {
  username = env("GRAFANA_CLOUD_TRACES_USERNAME") 
  password = env("GRAFANA_CLOUD_TRACES_PASSWORD")
}

//
// CONFIGURATION NOTES
//
// 1. All API services and Qdrant from docker-compose.prod.yml are monitored
// 2. Monitor usage at http://localhost:12345 (Alloy UI)
// 3. Tier 1 (30s scrape): backend-api, bff-api, auth-api
// 4. Tier 2 (60s scrape): search-api, ml-api, recommendation-api, qdrant
// 5. Frontend (Next.js) excluded - doesn't expose Prometheus metrics
// 6. Expected metrics count: ~6,000-8,000 series for API services + Qdrant (includes business metrics)
// 7. Log volume should be <12GB/month with ERROR/WARN filtering
// 8. OTLP traces available on ports 4317 (gRPC) and 4318 (HTTP)
// 9. Trace processing: batching + memory limiting for free tier optimization
// 10. Current sampling rate: 0.1 (10%) set in service TRACING_SAMPLE_RATE
// 11. Health checks: All API services monitored at /health endpoints
// 12. Docker logs: All container logs collected (ERROR/WARN only)
// 13. File logs: Service-specific log files collected (ERROR/WARN only)
// 14. Qdrant metrics: Vector operations, memory usage, collection stats
//