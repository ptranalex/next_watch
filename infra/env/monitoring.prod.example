# Production Monitoring Environment Configuration
# Copy this file to .env.monitoring.prod and fill in actual values

#
# PRODUCTION DOMAIN
#
PRODUCTION_DOMAIN=your-domain.com

#
# GRAFANA CONFIGURATION
#
# Strong admin password for Grafana
GRAFANA_ADMIN_PASSWORD=your-super-secure-grafana-admin-password

# Grafana database configuration (uses existing PostgreSQL)
GRAFANA_DB_NAME=grafana_prod
GRAFANA_DB_USER=grafana_user
GRAFANA_DB_PASSWORD=your-secure-grafana-db-password

# Grafana security secret key (generate with: openssl rand -base64 32)
GRAFANA_SECRET_KEY=your-grafana-secret-key-here

#
# EMAIL NOTIFICATIONS (SMTP)
#
# SMTP settings for alert notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-monitoring-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=monitoring@your-domain.com

#
# ALERT EMAIL ROUTING
#
# Default alert email
ALERT_EMAIL_TO=alerts@your-domain.com

# Critical alerts (immediate attention required)
CRITICAL_ALERT_EMAIL=critical@your-domain.com,sms@yourphone.com

# Warning alerts (action may be required)
WARNING_ALERT_EMAIL=warnings@your-domain.com

# Info alerts (daily digest)
INFO_ALERT_EMAIL=info@your-domain.com

# Business metric alerts
BUSINESS_ALERT_EMAIL=business@your-domain.com

# Infrastructure alerts
INFRA_ALERT_EMAIL=infrastructure@your-domain.com

#
# SLACK/DISCORD WEBHOOKS (Optional)
#
# Slack webhook for critical alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord webhook for team notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

#
# EXTERNAL MONITORING (Optional)
#
# PagerDuty integration key for critical alerts
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# Opsgenie API key for incident management
OPSGENIE_API_KEY=your-opsgenie-api-key

#
# BACKUP & RETENTION
#
# S3 configuration for metrics backup (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET_NAME=nextwatch-monitoring-backups
S3_REGION=us-east-1

# Metrics retention settings
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB
LOKI_RETENTION_PERIOD=30d

#
# SECURITY
#
# Basic auth for monitoring endpoints (if needed)
MONITORING_USERNAME=monitoring
MONITORING_PASSWORD=your-monitoring-access-password

# API keys for external integrations
MONITORING_API_KEY=your-monitoring-api-key

#
# PERFORMANCE TUNING
#
# Resource limits (adjust based on server capacity)
PROMETHEUS_MEMORY_LIMIT=2G
GRAFANA_MEMORY_LIMIT=1G
LOKI_MEMORY_LIMIT=1G
ALERTMANAGER_MEMORY_LIMIT=512M

# Scrape intervals (seconds)
DEFAULT_SCRAPE_INTERVAL=15
INFRASTRUCTURE_SCRAPE_INTERVAL=30
APPLICATION_SCRAPE_INTERVAL=15

#
# SSL/TLS (if using reverse proxy)
#
SSL_CERT_PATH=/etc/ssl/certs/your-domain.com.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.com.key

#
# LOGGING
#
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
