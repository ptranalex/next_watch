# Production Environment Configuration for Next Watch
# Copy this file to .env.prod and fill in the actual values

#
# DOCKER IMAGES
#
DOCKER_BACKEND_IMAGE=next-watch-backend:latest
DOCKER_AUTH_IMAGE=next-watch-auth:latest
DOCKER_BFF_IMAGE=next-watch-bff:latest
DOCKER_FRONTEND_IMAGE=next-watch-frontend:latest
DOCKER_IMPORTER_IMAGE=next-watch-importer:latest
DOCKER_RECOMMENDATION_IMAGE=next-watch-recommendation:latest
DOCKER_SEARCH_IMAGE=next-watch-search:latest
DOCKER_ML_IMAGE=next-watch-ml:latest

#
# DATABASE CONFIGURATION
#
POSTGRES_USER=next_watch_user
POSTGRES_PASSWORD=your-secure-database-password-here
POSTGRES_DB=next_watch

#
# SECURITY CONFIGURATION
#
# JWT Secret - MUST be a strong, random string in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production

# Optional: JWT Web Key (JWK) for advanced JWT features
JWT_JWK=
JWT_JWK_ROTATION_INTERVAL=86400

# Internal API Key for service-to-service communication
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=your-internal-api-key-for-service-communication

#
# EXTERNAL API KEYS
#
# TMDB (The Movie Database) API Access Token
# Get from: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your-tmdb-access-token-here

# OMDB (Open Movie Database) API Key
# Get from: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-api-key-here

#
# DEPLOYMENT CONFIGURATION
#
# Domain for production deployment
PRODUCTION_DOMAIN=your-domain.com

# SSL/TLS Configuration (if using reverse proxy)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

#
# MONITORING & LOGGING
#
# Log levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable performance metrics collection
ENABLE_PERFORMANCE_METRICS=true

#
# REDIS CONFIGURATION (if using external Redis)
#
# Redis connection settings (currently using host Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

#
# EMAIL CONFIGURATION (for auth notifications)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@your-domain.com

#
# RATE LIMITING
#
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

#
# CACHE CONFIGURATION
#
CACHE_TTL=300  # 5 minutes default cache TTL
CACHE_MAX_SIZE=1000  # Maximum number of cached items

#
# SECURITY HEADERS
#
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

#
# OBSERVABILITY (Grafana Cloud via Alloy) - optional
#
# Copy values from: infra/monitoring/alloy/.env.example
GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_METRICS_USERNAME=
GRAFANA_CLOUD_METRICS_PASSWORD=
GRAFANA_CLOUD_LOGS_URL=
GRAFANA_CLOUD_LOGS_USERNAME=
GRAFANA_CLOUD_LOGS_PASSWORD=
GRAFANA_CLOUD_TRACES_URL=
GRAFANA_CLOUD_TRACES_USERNAME=
GRAFANA_CLOUD_TRACES_PASSWORD=

#
# FEATURE FLAGS
#
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true

#
# PERFORMANCE TUNING
#
# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true

#
# DEVELOPMENT OVERRIDES (for staging environment)
#
# Uncomment these for staging/development
# DEBUG=true
# LOG_LEVEL=DEBUG
# CORS_ORIGINS=*
# ENABLE_PERFORMANCE_METRICS=false
