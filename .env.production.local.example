#
# NEXT WATCH PRODUCTION CONFIGURATION TEMPLATE
#
# Copy this to .env.production.local and fill with your actual production values
# NEVER commit .env.production.local to git!
#
# Quick setup:
#   cp .env.production.local.example .env.production.local
#   nano .env.production.local  # Edit with your values
#
#

#
# 1. PRODUCTION DOMAIN (REQUIRED)
#
PRODUCTION_DOMAIN=your-domain.com
NEXT_PUBLIC_BFF_API_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

#
# 2. DATABASE CONFIGURATION (REQUIRED)
#
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_database_password
POSTGRES_DB=next_watch

#
# 3. SECURITY KEYS (REQUIRED - Generate strong random values)
#
# JWT Secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here-min-32-chars

# Internal API key for service-to-service communication
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=your-internal-api-key-here

#
# 4. EXTERNAL API KEYS (OPTIONAL - for data import)
#
# TMDB API (https://www.themoviedb.org/settings/api)
TMDB_ACCESS_TOKEN=your-tmdb-access-token

# OMDB API (http://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your-omdb-api-key

#
# 5. GOOGLE OAUTH (OPTIONAL - for social login)
#
# Get from: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

#
# 6. GRAFANA CLOUD OBSERVABILITY (OPTIONAL - for monitoring)
#
# Get credentials from: https://grafana.com → Your Stack → Configuration

# Metrics (Prometheus)
GRAFANA_CLOUD_METRICS_URL=https://prometheus-prod-XX-prod-region.grafana.net/api/prom/push
GRAFANA_CLOUD_METRICS_USERNAME=your-metrics-username
GRAFANA_CLOUD_METRICS_PASSWORD=your-grafana-api-key

# Logs (Loki)
GRAFANA_CLOUD_LOGS_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOGS_USERNAME=your-logs-username
GRAFANA_CLOUD_LOGS_PASSWORD=your-grafana-api-key

# Traces (Tempo)
GRAFANA_CLOUD_TRACES_URL=https://tempo-prod-XX-prod-region.grafana.net:443
GRAFANA_CLOUD_TRACES_USERNAME=your-traces-username
GRAFANA_CLOUD_TRACES_PASSWORD=your-grafana-api-key

#
# 7. GRAFANA LOCAL DEPLOYMENT (OPTIONAL - if self-hosting)
#
# Grafana admin credentials
GRAFANA_ADMIN_PASSWORD=your-strong-grafana-password

# Grafana database
GRAFANA_DB_PASSWORD=your-grafana-db-password

# Grafana secret key (generate with: openssl rand -base64 32)
GRAFANA_SECRET_KEY=your-grafana-secret-key

#
# 8. EMAIL CONFIGURATION (OPTIONAL - for notifications)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=noreply@your-domain.com

# Alert email addresses
ALERT_EMAIL_TO=admin@your-domain.com
CRITICAL_ALERT_EMAIL=admin@your-domain.com

#
# 9. REDIS CONFIGURATION
#
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100
REDIS_TIMEOUT=5

#
# 10. FEATURE FLAGS
#
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PASSWORD_RESET=true
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true
NEXT_PUBLIC_ENABLE_RELATED_MOVIES=true

#
# 11. PERFORMANCE TUNING
#
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
LOG_LEVEL=INFO
ENABLE_PERFORMANCE_METRICS=true

#
# DEPLOYMENT CHECKLIST
#
# Before deploying to production, ensure you have:
# [ ] Set PRODUCTION_DOMAIN to your actual domain
# [ ] Generated strong random JWT_SECRET (min 32 chars)
# [ ] Generated strong random INTERNAL_API_KEY
# [ ] Set secure database password
# [ ] Configured external API keys (TMDB, OMDB) if using data import
# [ ] Set up Google OAuth if enabling social login
# [ ] Configured Grafana Cloud if using observability
# [ ] Set up SMTP for email notifications
# [ ] Reviewed all security settings
# [ ] Never committed this file to git
