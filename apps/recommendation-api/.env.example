# Server Configuration
HOST=0.0.0.0
PORT=8002
WORKERS=1
RELOAD=false
VERBOSE=false

# Environment
ENVIRONMENT=development  # development, staging, production
DEBUG=false
LOG_LEVEL=INFO
LOGS_DIR=logs

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_watch

# Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=movies

# ML API Configuration
ML_API_URL=http://localhost:8004
ML_API_TIMEOUT=30

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=512

# Recommendation Settings
RECOMMENDATION_COUNT=10
MIN_IMDB_RATING=6.0
SIMILARITY_THRESHOLD=0.7
USER_VECTOR_WEIGHT=0.6
CONTENT_VECTOR_WEIGHT=0.4

# Cache Configuration
ENABLE_CACHING=true
CACHE_TTL=3600  # 1 hour in seconds
CACHE_REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_MAX_CONNECTIONS=20
CACHE_REDIS_SOCKET_TIMEOUT=5
CACHE_REDIS_RETRY_ON_TIMEOUT=true
PRECOMPUTE_SIMILARITIES=false

# Performance Settings
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30
EMBEDDING_GENERATION_TIMEOUT=60

# Feature Flags
ENABLE_COLLABORATIVE_FILTERING=true
ENABLE_CONTENT_FILTERING=true
ENABLE_TRENDING_FALLBACK=true
ENABLE_DIVERSITY_BOOST=true

# Monitoring
ENABLE_METRICS=false
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30
