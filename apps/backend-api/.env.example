# Backend API Configuration Example
# Copy this file to .env or .env.local and modify as needed

# ------------------------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------------------------

# Server host and port
HOST=0.0.0.0
PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (forced to false in production)
DEBUG=false

# ------------------------------------------------------------------------------
# LOGGING AND MONITORING
# ------------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory for log files
LOGS_DIR=logs

# Performance monitoring
ENABLE_PERFORMANCE_METRICS=false

# SQLAlchemy logging level
SQLALCHEMY_LOG_LEVEL=WARNING

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# PostgreSQL database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_watch

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8001,http://localhost:8002

# ------------------------------------------------------------------------------
# CACHE AND REDIS CONFIGURATION
# ------------------------------------------------------------------------------

# Redis connection URL
CACHE_REDIS_URL=redis://localhost:6379/0

# Redis connection pool settings
CACHE_REDIS_MAX_CONNECTIONS=10
CACHE_REDIS_SOCKET_TIMEOUT=30
CACHE_REDIS_SOCKET_CONNECT_TIMEOUT=30
CACHE_REDIS_RETRY_ON_TIMEOUT=true

# ------------------------------------------------------------------------------
# AUTHENTICATION AND SECURITY
# ------------------------------------------------------------------------------

# Service-to-service authentication key
INTERNAL_API_KEY=bff-to-backend-secret-key-change-in-production

# JWT Configuration (MUST match across all services)
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_ALGORITHM=HS256

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JWK rotation interval in seconds (24 hours default)
JWT_JWK_ROTATION_INTERVAL=86400

# ------------------------------------------------------------------------------
# ADVANCED JWT CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------------------------

# JSON Web Key for advanced JWT features
# JWT_JWK={"kty":"oct","k":"your-jwk-key-here"}

# ------------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES
# ------------------------------------------------------------------------------

# Uncomment these for development environment
# DEBUG=true
# LOG_LEVEL=DEBUG
# ENABLE_PERFORMANCE_METRICS=true
