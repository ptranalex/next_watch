***REMOVED*** Backend API Configuration Example
***REMOVED*** Copy this file to .env or .env.local and modify as needed

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** SERVER CONFIGURATION
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** Server host and port
HOST=0.0.0.0
PORT=8000

***REMOVED*** Environment: development, staging, production
ENVIRONMENT=development

***REMOVED*** Enable debug mode (forced to false in production)
DEBUG=false

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** LOGGING AND MONITORING
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

***REMOVED*** Directory for log files
LOGS_DIR=logs

***REMOVED*** Performance monitoring
ENABLE_PERFORMANCE_METRICS=false

***REMOVED*** SQLAlchemy logging level
SQLALCHEMY_LOG_LEVEL=WARNING

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** DATABASE CONFIGURATION
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** PostgreSQL database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_watch

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** CORS CONFIGURATION
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** Comma-separated list of allowed origins for CORS
***REMOVED*** Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8001,http://localhost:8002

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** CACHE AND REDIS CONFIGURATION
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** Redis connection URL
CACHE_REDIS_URL=redis://localhost:6379/0

***REMOVED*** Redis connection pool settings
CACHE_REDIS_MAX_CONNECTIONS=10
CACHE_REDIS_SOCKET_TIMEOUT=30
CACHE_REDIS_SOCKET_CONNECT_TIMEOUT=30
CACHE_REDIS_RETRY_ON_TIMEOUT=true

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** AUTHENTICATION AND SECURITY
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** Service-to-service authentication key
INTERNAL_API_KEY=bff-to-backend-secret-key-change-in-production

***REMOVED*** JWT Configuration (MUST match across all services)
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_ALGORITHM=HS256

***REMOVED*** Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

***REMOVED*** JWK rotation interval in seconds (24 hours default)
JWT_JWK_ROTATION_INTERVAL=86400

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** ADVANCED JWT CONFIGURATION (OPTIONAL)
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** JSON Web Key for advanced JWT features
***REMOVED*** JWT_JWK={"kty":"oct","k":"your-jwk-key-here"}

***REMOVED*** ------------------------------------------------------------------------------
***REMOVED*** DEVELOPMENT OVERRIDES
***REMOVED*** ------------------------------------------------------------------------------

***REMOVED*** Uncomment these for development environment
***REMOVED*** DEBUG=true
***REMOVED*** LOG_LEVEL=DEBUG
***REMOVED*** ENABLE_PERFORMANCE_METRICS=true
