{
  "name": "bff-api-dev-scripts",
  "version": "1.0.0",
  "description": "Development scripts for BFF API",
  "scripts": {
    "dev": "BACKEND_API_URL=http://localhost:8000 poetry run bff-api serve",
    "test": "curl -s http://localhost:8001/health/ | jq",
    "test:bff": "curl -s http://localhost:8001/bff/home | jq",
    "health": "curl -s http://localhost:8001/health/ && echo",
    "_gateway:start": "cd ../api-gateway && docker run -d --name next-watch-gateway -p 8080:8080 next-watch-gateway",
    "_gateway:stop": "docker stop next-watch-gateway && docker rm next-watch-gateway",
    "_dev:gateway": "BACKEND_API_URL=http://localhost:8080 poetry run bff-api serve"
  }
}
