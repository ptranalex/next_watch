#
# Search API .dockerignore - Optimized for fast builds
#
# This file reduces Docker build context from ~360MB to <10MB by excluding
# unnecessary files and directories for the Search API container build.

# -----------------------------------------------------------------------------
# PYTHON BUILD ARTIFACTS
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl

# -----------------------------------------------------------------------------
# VIRTUAL ENVIRONMENTS & PACKAGE MANAGERS
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.hatch/
.conda/
.poetry/
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# DEVELOPMENT TOOLS & IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
.cursor/
*.swp
*.swo
*~
.vim/
.emacs.d/
.atom/

# -----------------------------------------------------------------------------
# OPERATING SYSTEM FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# VERSION CONTROL
# -----------------------------------------------------------------------------
.git/
.gitignore
.gitattributes
.github/

# -----------------------------------------------------------------------------
# TESTING & COVERAGE
# -----------------------------------------------------------------------------
tests/
test_*/
*_test.py
test_*.py
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.prof

# -----------------------------------------------------------------------------
# DOCUMENTATION & EXAMPLES
# -----------------------------------------------------------------------------
docs/
*.md
*.rst
*.txt
!requirements*.txt
!pyproject.toml
examples/
scripts/
.readthedocs.yml
docs/_build/

# -----------------------------------------------------------------------------
# LOGS & TEMPORARY FILES
# -----------------------------------------------------------------------------
*.log
logs/
.logs/
tmp/
temp/
.tmp/
.temp/

# -----------------------------------------------------------------------------
# DOCKER & CONTAINERS
# -----------------------------------------------------------------------------
Dockerfile*
docker-compose*.yml
.dockerignore
*.dockerfile

# -----------------------------------------------------------------------------
# OTHER APP DIRECTORIES (Search only needs its own files + shared libs)
# -----------------------------------------------------------------------------
# Exclude all other apps - we only need search-api and shared libs
apps/auth-api/
apps/backend-api/
apps/bff-api/
apps/data-importer/
apps/ml-api/
apps/recommendation-api/
apps/web-nextjs/
apps/mobile-flutter/

# Exclude non-essential libs (keep only what Search needs)
# libs/movie-storage/  # Search doesn't use this directly

# -----------------------------------------------------------------------------
# INFRASTRUCTURE & DEPLOYMENT
# -----------------------------------------------------------------------------
infra/
.k8s/
.terraform/
.helm/

# -----------------------------------------------------------------------------
# PROJECT ARTIFACTS & CACHES
# -----------------------------------------------------------------------------
.mypy_cache/
.ruff_cache/
.black/
.isort.cfg
.bandit
.safety
results/
.benchmarks/
.profiling/
model_cache/

# -----------------------------------------------------------------------------
# KEEP ONLY WHAT'S NEEDED FOR SEARCH API BUILD:
# -----------------------------------------------------------------------------
# ✅ libs/cache/         - NextWatch Cache Library (Redis integration)
# ✅ libs/cli/           - NextWatch CLI Framework
# ✅ libs/config/        - NextWatch Config Library
# ✅ libs/fast-core/     - FastAPI Core Framework
# ✅ apps/search-api/src/ - Search API source code
# ✅ apps/search-api/pyproject.toml - Dependencies
