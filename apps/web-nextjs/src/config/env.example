# Next Watch Frontend - Environment Variables
# Copy this file to .env.local in the root directory and customize for your environment

#-------------------------------------------------------------------------------
# API Configuration
#-------------------------------------------------------------------------------
# Base URL for the BFF API (recommended for production)
NEXT_PUBLIC_BFF_API_URL=http://localhost:8001

# Base URL for the backend API (direct access, for debugging)
NEXT_PUBLIC_API_URL=http://localhost:8000

# API version (if needed)
NEXT_PUBLIC_API_VERSION=v1

# Timeout for API requests in milliseconds
NEXT_PUBLIC_API_TIMEOUT=10000

#-------------------------------------------------------------------------------
# Authentication
#-------------------------------------------------------------------------------
# Auth API URL (for direct auth access if needed)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8003

# Auth token storage key in localStorage
NEXT_PUBLIC_AUTH_TOKEN_KEY=auth_token

# Token expiration time in seconds (default: 86400 = 24 hours)
NEXT_PUBLIC_TOKEN_EXPIRATION=86400

# Google OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

#-------------------------------------------------------------------------------
# Feature Flags
#-------------------------------------------------------------------------------
# Enable/disable related movies section (default: true)
NEXT_PUBLIC_ENABLE_RELATED_MOVIES=true

# Enable/disable movie recommendations (default: true)
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true

# Enable/disable movie cast display (default: true)
NEXT_PUBLIC_ENABLE_CAST=true

# Enable/disable search functionality (default: true)
NEXT_PUBLIC_ENABLE_SEARCH=true

# Enable/disable movie trailers (default: true)
NEXT_PUBLIC_ENABLE_TRAILERS=true

# Enable/disable Fshare links (default: true)
NEXT_PUBLIC_ENABLE_FSHARE=true

#-------------------------------------------------------------------------------
# Analytics (Server-side only)
#-------------------------------------------------------------------------------
# Google Analytics ID
GA_TRACKING_ID=

# Enable/disable analytics in development (default: false)
ENABLE_ANALYTICS_IN_DEV=false

#-------------------------------------------------------------------------------
# Content Delivery Network (CDN)
#-------------------------------------------------------------------------------
# Images CDN base URL
NEXT_PUBLIC_IMAGES_CDN_URL=https://image.tmdb.org/t/p

# Default poster image size
NEXT_PUBLIC_POSTER_SIZE=w500

# Default backdrop image size
NEXT_PUBLIC_BACKDROP_SIZE=original

# Default profile image size
NEXT_PUBLIC_PROFILE_SIZE=w185

#-------------------------------------------------------------------------------
# Development Settings
#-------------------------------------------------------------------------------
# Environment (development, staging, production)
NODE_ENV=development

# Enable/disable debug logging in frontend
NEXT_PUBLIC_DEBUG=false
