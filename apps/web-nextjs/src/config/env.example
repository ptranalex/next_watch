***REMOVED*** Next Watch Frontend - Environment Variables
***REMOVED*** Copy this file to .env.local in the root directory and customize for your environment

***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** API Configuration
***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Base URL for the BFF API (recommended for production)
NEXT_PUBLIC_BFF_API_URL=http://localhost:8001

***REMOVED*** Base URL for the backend API (direct access, for debugging)
NEXT_PUBLIC_API_URL=http://localhost:8000

***REMOVED*** API version (if needed)
NEXT_PUBLIC_API_VERSION=v1

***REMOVED*** Timeout for API requests in milliseconds
NEXT_PUBLIC_API_TIMEOUT=10000

***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Authentication
***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Auth API URL (for direct auth access if needed)
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8003

***REMOVED*** Auth token storage key in localStorage
NEXT_PUBLIC_AUTH_TOKEN_KEY=auth_token

***REMOVED*** Token expiration time in seconds (default: 86400 = 24 hours)
NEXT_PUBLIC_TOKEN_EXPIRATION=86400

***REMOVED*** Google OAuth client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Feature Flags
***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Enable/disable related movies section (default: true)
NEXT_PUBLIC_ENABLE_RELATED_MOVIES=true

***REMOVED*** Enable/disable movie recommendations (default: true)
NEXT_PUBLIC_ENABLE_RECOMMENDATIONS=true

***REMOVED*** Enable/disable movie cast display (default: true)
NEXT_PUBLIC_ENABLE_CAST=true

***REMOVED*** Enable/disable search functionality (default: true)
NEXT_PUBLIC_ENABLE_SEARCH=true

***REMOVED*** Enable/disable movie trailers (default: true)
NEXT_PUBLIC_ENABLE_TRAILERS=true

***REMOVED*** Enable/disable Fshare links (default: true)
NEXT_PUBLIC_ENABLE_FSHARE=true

***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Analytics (Server-side only)
***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Google Analytics ID
GA_TRACKING_ID=

***REMOVED*** Enable/disable analytics in development (default: false)
ENABLE_ANALYTICS_IN_DEV=false

***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Content Delivery Network (CDN)
***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Images CDN base URL
NEXT_PUBLIC_IMAGES_CDN_URL=https://image.tmdb.org/t/p

***REMOVED*** Default poster image size
NEXT_PUBLIC_POSTER_SIZE=w500

***REMOVED*** Default backdrop image size
NEXT_PUBLIC_BACKDROP_SIZE=original

***REMOVED*** Default profile image size
NEXT_PUBLIC_PROFILE_SIZE=w185

***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Development Settings
***REMOVED***-------------------------------------------------------------------------------
***REMOVED*** Environment (development, staging, production)
NODE_ENV=development

***REMOVED*** Enable/disable debug logging in frontend
NEXT_PUBLIC_DEBUG=false
