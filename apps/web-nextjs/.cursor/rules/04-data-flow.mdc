***REMOVED******REMOVED******REMOVED*** 1. Domain Hook Structure

```typescript
// hooks/domain/movie/useMovie.ts
export const useMovie = (id: string) => {
  const logger = createLogger("useMovie");

  const query = useQuery({
    queryKey: ["movie", id],
    queryFn: async () => {
      logger.debug(`Fetching movie: ${id}`);
      return movieAPI.getById(id);
    },
    enabled: !!id,
    staleTime: 10 * 60 * 1000,
    onError: (error) => {
      logger.error(`Failed to fetch movie ${id}:`, error);
    },
  });

  const { updateMovie } = useMovieSync();

  return {
    ...query,
    updateMovie: (movie: Movie) => updateMovie(movie),
  };
};
```

***REMOVED******REMOVED******REMOVED*** 2. Composite Hook Pattern

```typescript
// hooks/domain/movie/useMovieFilters.ts
export const useMovieFilters = () => {
  const { params, updateParams } = useQueryParams();
  const { genres } = useGenres();

  // Sync filters with URL
  const filters = useMemo(
    () => ({
      genre: params.genre ? params.genre.split(",") : [],
      year: params.year ? parseInt(params.year) : null,
      rating: params.rating ? parseFloat(params.rating) : 0,
    }),
    [params]
  );

  const setFilter = useCallback(
    (key: string, value: any) => {
      updateParams({ [key]: value });
    },
    [updateParams]
  );

  const resetFilters = useCallback(() => {
    updateParams({}, { replace: true });
  }, [updateParams]);

  return {
    filters,
    setFilter,
    resetFilters,
    availableGenres: genres,
  };
};
```

***REMOVED******REMOVED******REMOVED*** 3. Performance Hook Pattern

```typescript
// hooks/performance/useDebouncedEffect.ts
export const useDebouncedEffect = (
  effect: () => void,
  delay: number,
  deps: DependencyList
) => {
  const logger = createLogger("useDebouncedEffect");

  useEffect(() => {
    logger.debug(`Setting up debounced effect with delay: ${delay}ms`);

    const timer = setTimeout(() => {
      logger.debug("Executing debounced effect");
      effect();
    }, delay);

    return () => {
      logger.debug("Clearing debounced effect timer");
      clearTimeout(timer);
    };
  }, [...deps, delay]);
};
```

***REMOVED******REMOVED*** 🔄 Error Handling Patterns

***REMOVED******REMOVED******REMOVED*** 1. Query Error Handling

```typescript
// ✅ CORRECT - Comprehensive error handling
const useMovieWithErrorHandling = (id: string) => {
  const toast = useToast();
  const logger = createLogger("useMovieWithErrorHandling");

  return useQuery({
    queryKey: ["movie", id],
    queryFn: () => movieAPI.getById(id),
    retry: (failureCount, error) => {
      // Custom retry logic
      if (error.status === 404) return false;
      return failureCount < 3;
    },
    onError: (error) => {
      logger.error(`Failed to load movie ${id}:`, error);

      if (error.status === 404) {
        toast.error("Movie not found");
      } else if (error.status >= 500) {
        toast.error("Server error. Please try again later.");
      } else {
        toast.error("Failed to load movie");
      }
    },
  });
};
```

***REMOVED******REMOVED******REMOVED*** 2. Mutation Error Handling

```typescript
// ✅ CORRECT - Mutation with error recovery
const useMovieMutation = () => {
  const toast = useToast();
  const logger = createLogger("useMovieMutation");

  return useMutation({
    mutationFn: updateMovieAPI,
    onError: (error, variables, context) => {
      logger.error("Movie update failed:", error, { variables, context });

      // Revert optimistic update
      if (context?.rollback) {
        context.rollback();
      }

      // User feedback
      toast.error("Failed to update movie. Changes have been reverted.");
    },
    onSuccess: (data) => {
      logger.info("Movie updated successfully:", data.id);
      toast.success("Movie updated successfully");
    },
  });
};
```

