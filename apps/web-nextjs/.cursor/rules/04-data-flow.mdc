***REMOVED******REMOVED******REMOVED*** 2. Optimistic Updates Pattern

**REQUIRED** for better user experience:

```typescript
const useMovieActions = (movieId: string) => {
  const queryClient = useQueryClient();
  const toast = useToast();

  const toggleWatched = useMutation({
    mutationFn: (watched: boolean) =>
      userInteractionAPI.toggleWatched(movieId, watched),

    onMutate: async (watched) => {
      // 1. Cancel outgoing queries
      await queryClient.cancelQueries(["movie", movieId]);

      // 2. Snapshot previous value
      const previousMovie = queryClient.getQueryData(["movie", movieId]);

      // 3. Optimistically update
      queryClient.setQueryData(["movie", movieId], (old: Movie) => ({
        ...old,
        watched,
      }));

      return { previousMovie };
    },

    onError: (error, variables, context) => {
      // 4. Revert on error
      queryClient.setQueryData(["movie", movieId], context?.previousMovie);
      toast.error("Failed to update movie status");
    },

    onSuccess: () => {
      // 5. Invalidate related queries
      queryClient.invalidateQueries(["movies"]);
      queryClient.invalidateQueries(["user", "stats"]);
    },
  });

  return { toggleWatched };
};
```

***REMOVED******REMOVED******REMOVED*** 3. Data Synchronization Pattern

```typescript
// ✅ CORRECT - Coordinated updates across components
const useMovieSync = () => {
  const queryClient = useQueryClient();

  const updateMovie = useCallback(
    (updatedMovie: Movie) => {
      // Update individual movie queries
      queryClient.setQueryData(["movie", updatedMovie.id], updatedMovie);

      // Update movie list queries
      queryClient.setQueriesData({ queryKey: ["movies"] }, (old: any) => {
        if (!old?.pages) return old;

        return {
          ...old,
          pages: old.pages.map((page: any) => ({
            ...page,
            items: page.items.map((movie: Movie) =>
              movie.id === updatedMovie.id ? updatedMovie : movie
            ),
          })),
        };
      });
    },
    [queryClient]
  );

  return { updateMovie };
};
```

