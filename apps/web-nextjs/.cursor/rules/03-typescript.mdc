***REMOVED******REMOVED*** 🚨 Type Anti-Patterns

***REMOVED******REMOVED******REMOVED*** Forbidden Practices

```typescript
// ❌ NEVER - Using 'any' type
interface BadProps {
  data: any; // Use proper typing
  callback: any; // Use specific callback types
}

// ❌ NEVER - Inline callback types when shared types exist
interface BadCallbackProps {
  onClick: () => void; // Use VoidCallback
  onSubmit: () => Promise<void>; // Use AsyncCallback
  onChange: (value: string) => void; // Use ChangeHandler<string>
}

// ❌ NEVER - Duplicating existing interfaces
interface LocalButtonProps {
  size: "sm" | "md" | "lg"; // ComponentSize already exists
  onClick: () => void; // VoidCallback already exists
}

// ❌ NEVER - Missing generic constraints
interface BadGenericProps<T> {
  items: T[]; // What kind of T? Add constraints
  onSelect: (item: T) => void;
}

// ✅ CORRECT - Proper generic constraints
interface GoodGenericProps<T extends { id: string }> {
  items: T[];
  onSelect: ChangeHandler<T>;
}
```

