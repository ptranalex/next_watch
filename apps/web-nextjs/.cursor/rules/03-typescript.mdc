***REMOVED******REMOVED******REMOVED*** Atoms Types (`./atoms/types.ts`)

Basic, indivisible types that serve as building blocks:

```typescript
// Basic component sizes
export type ComponentSize = "xs" | "sm" | "md" | "lg" | "xl";
export type ExtendedComponentSize = ComponentSize | "2xl";

// Fundamental callbacks
export type VoidCallback = () => void;
export type AsyncCallback = () => Promise<void>;
export type ChangeHandler<T> = (value: T) => void;

// Loading and error states
export interface LoadingStateProps {
  isLoading?: boolean;
  loadingText?: string;
}

export interface ErrorStateProps {
  error?: string | null;
  onRetry?: VoidCallback;
}

// Base interactive elements
export interface BaseToggleProps extends LoadingStateProps {
  isActive: boolean;
  size?: ComponentSize;
  ariaLabel?: string;
  onToggle: VoidCallback;
}

// Utility types
export interface WithChildren {
  children: React.ReactNode;
}

export interface WithOptionalChildren {
  children?: React.ReactNode;
}
```

