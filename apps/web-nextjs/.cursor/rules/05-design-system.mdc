***REMOVED******REMOVED******REMOVED*** 2. Variant-Based Styling

```typescript
// ✅ CORRECT - Variant-based component design
interface CardProps {
  variant?: "elevated" | "outlined" | "filled";
  size?: ComponentSize;
}

const Card = ({ variant = "elevated", size = "md", children }) => {
  const variantStyles = {
    elevated: {
      bg: "bg.primary",
      boxShadow: "md",
    },
    outlined: {
      bg: "transparent",
      border: "1px solid",
      borderColor: "bg.tertiary",
    },
    filled: {
      bg: "bg.secondary",
    },
  };

  return (
    <Box
      {...variantStyles[variant]}
      p={size === "sm" ? 3 : size === "lg" ? 6 : 4}
      borderRadius="md"
    >
      {children}
    </Box>
  );
};
```

