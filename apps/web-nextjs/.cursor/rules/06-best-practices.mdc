***REMOVED******REMOVED******REMOVED*** 3. Testing Considerations

```typescript
// ✅ CORRECT - Testable component structure
const MovieCard = ({ movie, onUpdate }: MovieCardProps) => {
  const logger = createLogger("MovieCard");

  // Separate business logic for easier testing
  const isWatched = useMemo(() => movie.watched, [movie.watched]);
  const canEdit = useMemo(() => user?.permissions?.includes("edit"), [user]);

  // Extract handlers for testing
  const handleToggleWatched = useCallback(() => {
    logger.info("Toggling watched status", { movieId: movie.id });
    onUpdate({ ...movie, watched: !movie.watched });
  }, [movie, onUpdate]);

  return (
    <Box data-testid={`movie-card-${movie.id}`}>
      <Button
        data-testid="toggle-watched-button"
        onClick={handleToggleWatched}
        aria-label={isWatched ? "Mark as unwatched" : "Mark as watched"}
      >
        {isWatched ? "Watched" : "Watch"}
      </Button>
    </Box>
  );
};
```

