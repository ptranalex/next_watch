***REMOVED******REMOVED*** 🛡️ Error Handling Patterns

***REMOVED******REMOVED******REMOVED*** 1. Component-Level Error Boundaries

**REQUIRED** for all async components:

```typescript
// ✅ CORRECT - Wrap async components
<ErrorBoundary
  fallback={<ComponentSkeleton />}
  onError={(error, errorInfo) => {
    logger.error("Component error boundary triggered", {
      error: error.message,
      stack: error.stack,
      componentStack: errorInfo.componentStack,
    });
  }}
>
  <AsyncComponent />
</ErrorBoundary>
```

***REMOVED******REMOVED******REMOVED*** 2. Hook-Level Error Handling

```typescript
// ✅ CORRECT - Comprehensive error handling in hooks
const useMovieWithErrorHandling = (id: string) => {
  const toast = useToast();
  const logger = createLogger("useMovieWithErrorHandling");

  return useQuery({
    queryKey: ["movie", id],
    queryFn: () => movieAPI.getById(id),
    retry: (failureCount, error) => {
      logger.warn(`Retry attempt ${failureCount} for movie ${id}`, { error });

      // Don't retry 4xx errors
      if (error.status >= 400 && error.status < 500) {
        return false;
      }

      return failureCount < 3;
    },
    onError: (error) => {
      logger.error(`Failed to load movie ${id}`, {
        error: error.message,
        status: error.status,
        movieId: id,
      });

      // User-friendly error messages
      if (error.status === 404) {
        toast.error("Movie not found");
      } else if (error.status >= 500) {
        toast.error("Server error. Please try again later.");
      } else {
        toast.error("Failed to load movie");
      }
    },
  });
};
```

***REMOVED******REMOVED******REMOVED*** 3. Async Error Handling

```typescript
// ✅ CORRECT - Proper async error handling
const handleAsyncAction = useCallback(async (movieId: string) => {
  try {
    logger.info("Starting async action", { movieId });

    const result = await movieAPI.updateMovie(movieId, data);

    logger.info("Async action completed", { movieId, result });
    toast.success("Movie updated successfully");
  } catch (error) {
    logger.error("Async action failed", {
      error: error.message,
      movieId,
      stack: error.stack,
    });

    toast.error("Failed to update movie");
    throw error; // Re-throw for upstream handling
  }
}, []);

// ❌ NEVER - Unhandled promises
const handleBadAction = () => {
  updateMovie(data); // Missing error handling
};
```

***REMOVED******REMOVED*** ⚡ Performance Optimization Rules

***REMOVED******REMOVED******REMOVED*** 1. Memoization Patterns

**MANDATORY** for expensive operations:

```typescript
// ✅ CORRECT - React.memo for expensive components
const ExpensiveComponent = React.memo(
  ({ data, onAction }) => {
    const logger = createLogger("ExpensiveComponent");

    useEffect(() => {
      logger.debug("ExpensiveComponent rendered", { dataLength: data.length });
    });

    return <ComplexRendering data={data} />;
  },
  (prevProps, nextProps) => {
    // Custom comparison for complex props
    return (
      prevProps.data.length === nextProps.data.length &&
      prevProps.onAction === nextProps.onAction
    );
  }
);

// ✅ CORRECT - useMemo for expensive calculations
const Component = ({ movies, filters }) => {
  const filteredMovies = useMemo(() => {
    logger.debug("Recalculating filtered movies", {
      moviesCount: movies.length,
      filtersApplied: Object.keys(filters).length,
    });

    return movies.filter((movie) => applyFilters(movie, filters));
  }, [movies, filters]);

  // ✅ CORRECT - useCallback for stable references
  const handleMovieSelect = useCallback(
    (movieId: string) => {
      logger.info("Movie selected", { movieId });
      onMovieSelect(movieId);
    },
    [onMovieSelect]
  );
};
```

***REMOVED******REMOVED******REMOVED*** 2. Dynamic Loading Patterns

```typescript
// ✅ CORRECT - Dynamic imports for large components
const HeavyComponent = dynamic(() => import("./HeavyComponent"), {
  loading: () => {
    logger.debug("Loading HeavyComponent dynamically");
    return <LoadingSkeleton />;
  },
  ssr: false,
});

// ✅ CORRECT - Conditional loading
const ConditionalComponent = ({ shouldLoad, ...props }) => {
  if (!shouldLoad) {
    logger.debug("ConditionalComponent not loaded");
    return null;
  }

  return (
    <Suspense fallback={<LoadingSkeleton />}>
      <HeavyComponent {...props} />
    </Suspense>
  );
};

// ✅ CORRECT - Lazy loading with intersection observer
const LazyImage = ({ src, alt }) => {
  const [isInView, setIsInView] = useState(false);
  const imgRef = useRef();

  useIntersectionObserver(imgRef, {
    onIntersect: () => {
      logger.debug("Image coming into view", { src });
      setIsInView(true);
    },
  });

  return (
    <Box ref={imgRef}>
      {isInView ? <Image src={src} alt={alt} /> : <Skeleton height="200px" />}
    </Box>
  );
};
```

