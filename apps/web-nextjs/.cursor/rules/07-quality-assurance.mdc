***REMOVED******REMOVED******REMOVED*** Performance Anti-Patterns

```typescript
// ❌ NEVER - Expensive operations without memoization
const BadPerformanceComponent = ({ items, filters }) => {
  // Recalculates on every render
  const filteredItems = items.filter((item) => applyFilters(item, filters));

  // Creates new function on every render
  const handleClick = (item) => {
    processItem(item);
  };

  return (
    <div>
      {filteredItems.map((item) => (
        <Item key={item.id} data={item} onClick={handleClick} />
      ))}
    </div>
  );
};

// ✅ CORRECT - Proper memoization
const GoodPerformanceComponent = ({ items, filters }) => {
  const filteredItems = useMemo(
    () => items.filter((item) => applyFilters(item, filters)),
    [items, filters]
  );

  const handleClick = useCallback((item) => {
    processItem(item);
  }, []);

  return (
    <div>
      {filteredItems.map((item) => (
        <Item key={item.id} data={item} onClick={handleClick} />
      ))}
    </div>
  );
};
```

