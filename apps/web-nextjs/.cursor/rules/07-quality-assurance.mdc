```typescript
// ✅ CORRECT - Testable component design
const TestableComponent = ({ data, onAction }: ComponentProps) => {
  const logger = createLogger("TestableComponent");

  // Extracted business logic for easier testing
  const isValid = useMemo(() => validateData(data), [data]);
  const canPerformAction = useMemo(
    () => isValid && user?.permissions?.includes("action"),
    [isValid, user]
  );

  // Separated handlers for unit testing
  const handleAction = useCallback(() => {
    if (!canPerformAction) {
      logger.warn("Action attempted without permission");
      return;
    }

    logger.info("Action performed", { dataId: data.id });
    onAction(data);
  }, [canPerformAction, data, onAction]);

  return (
    <Box data-testid="testable-component">
      <Button
        data-testid="action-button"
        onClick={handleAction}
        disabled={!canPerformAction}
        aria-label={`Perform action on ${data.name}`}
      >
        Perform Action
      </Button>
    </Box>
  );
};

// Test structure example
