```typescript
// Step 1: Create types file
// features/[domain]/types.ts
import type { VoidCallback, AsyncCallback } from "@/components/ui/atoms/types";
import type { DomainEntity } from "@/domain/entities";

export interface FeatureComponentProps {
  data: DomainEntity;
  onUpdate: DomainUpdateCallback;
  size?: ComponentSize;
  isLoading?: boolean;
}

export type DomainUpdateCallback = (entity: DomainEntity) => void;
export type DomainActionCallback = (action: string) => Promise<void>;

// Step 2: Create component with proper structure
// features/[domain]/FeatureComponent.tsx
import React, { useEffect, useCallback } from "react";
import { Box, Button } from "@chakra-ui/react";
import { createLogger } from "@/utils/logging";
import type { FeatureComponentProps } from "./types";

const logger = createLogger("FeatureComponent");

const FeatureComponent: React.FC<FeatureComponentProps> = ({
  data,
  onUpdate,
  size = "md",
  isLoading = false,
}) => {
  // Required initialization logging
  useEffect(() => {
    logger.debug("FeatureComponent initialized", {
      dataId: data.id,
      size,
      isLoading,
    });
  }, [data.id, size, isLoading]);

  // Memoized handlers
  const handleAction = useCallback(() => {
    logger.info("Feature action triggered", { dataId: data.id });
    onUpdate(data);
  }, [data, onUpdate]);

  return (
    <Box>
      <Button onClick={handleAction} isLoading={isLoading} size={size}>
        Action
      </Button>
    </Box>
  );
};

export default FeatureComponent;

// Step 3: Create barrel export
// features/[domain]/index.ts
// Main components (public API)
export { default as FeatureComponent } from "./FeatureComponent";

// Types (public API)
export type {
  FeatureComponentProps,
  DomainUpdateCallback,
  DomainActionCallback,
} from "./types";

// Internal components (not exported - used only within this module)
// - InternalComponent (internal to FeatureComponent)
```

***REMOVED******REMOVED******REMOVED*** 3. Hook Development Process

```typescript
// Step 1: Create domain hook
// hooks/domain/[domain]/useDomainEntity.ts
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { createLogger } from "@/utils/logging";
import { domainAPI } from "@/services/api";
import type { DomainEntity } from "@/domain/entities";

const logger = createLogger("useDomainEntity");

export const useDomainEntity = (id: string) => {
  const queryClient = useQueryClient();

  const query = useQuery({
    queryKey: ["domain-entity", id],
    queryFn: async () => {
      logger.debug(`Fetching domain entity: ${id}`);
      return domainAPI.getById(id);
    },
    enabled: !!id,
    staleTime: 10 * 60 * 1000, // 10 minutes
    onError: (error) => {
      logger.error(`Failed to fetch domain entity ${id}`, {
        error: error.message,
        entityId: id,
      });
    },
  });

  const updateEntity = useCallback(
    (entity: DomainEntity) => {
      logger.info("Updating domain entity in cache", { entityId: entity.id });
      queryClient.setQueryData(["domain-entity", id], entity);
    },
    [queryClient, id]
  );

  return {
    ...query,
    updateEntity,
  };
};

// Step 2: Export from hooks index
// hooks/index.ts
export { useDomainEntity } from "./domain/[domain]/useDomainEntity";
```

