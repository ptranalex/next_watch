// ✅ REQUIRED - WCAG 2.1 AA compliance
interface AccessibilityStandards {
  semanticHTML: true; // Use proper HTML elements
  keyboardNavigation: true; // Full keyboard support
  screenReaderSupport: true; // Proper ARIA labels
