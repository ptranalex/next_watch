const AccessibleComponent = ({ items, onSelect }) => {
  return (
    <Box role="listbox" aria-label="Movie selection">
      {items.map((item, index) => (
        <Box
          key={item.id}
          role="option"
          tabIndex={0}
          aria-selected={item.selected}
          aria-describedby={`item-description-${item.id}`}
          onKeyDown={(e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              onSelect(item);
            }
          }}
          _focus={{
            boxShadow: "outline",
            outline: "2px solid",
            outlineColor: "colors.primary",
          }}
        >
          <VisuallyHidden id={`item-description-${item.id}`}>
            {item.description}
          </VisuallyHidden>
          {item.title}
        </Box>
      ))}
    </Box>
  );
};
