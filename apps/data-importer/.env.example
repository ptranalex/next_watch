# Data Importer Configuration Example
# Copy this file to .env or .env.local and modify as needed

# ------------------------------------------------------------------------------
# API KEYS AND CREDENTIALS
# ------------------------------------------------------------------------------

# TMDB API (The Movie Database)
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# OMDB API (Open Movie Database)
OMDB_API_KEY=your_omdb_api_key_here

# ------------------------------------------------------------------------------
# PATHS AND DIRECTORIES
# ------------------------------------------------------------------------------

# Directory for configuration files
CONFIG_DIR=config

# Directory for log files
LOGS_DIR=logs

# Directory for downloaded data
DATA_DIR=data

# ------------------------------------------------------------------------------
# LOGGING SETTINGS
# ------------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# More detailed console output
VERBOSE=false

# Minimize console output (overrides VERBOSE)
QUIET=false

# ------------------------------------------------------------------------------
# MOVIE SYNC CONFIGURATION
# ------------------------------------------------------------------------------

# Year range to sync movies from
MOVIE_SYNC_START_YEAR=1990
# Current year will be used if not specified
MOVIE_SYNC_END_YEAR=2023

# Number of movies to sync per year
MOVIE_SYNC_LIMIT_PER_YEAR=100

# Minimum vote count for movies to include
MOVIE_SYNC_MIN_VOTE_COUNT=100

# How to sort movies: popularity.desc or vote_count.desc
MOVIE_SYNC_SORT_BY=vote_count.desc

# Whether to include cast and crew information
MOVIE_SYNC_INCLUDE_CREDITS=true

# Whether to include video/trailer information
MOVIE_SYNC_INCLUDE_VIDEOS=true

# Whether to save movies to the database
MOVIE_SYNC_SAVE_TO_DB=true
