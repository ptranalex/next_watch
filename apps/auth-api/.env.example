# Authentication API Configuration
# Copy this file to .env and customize for your environment

# ------------------------------------------------------------------------------
# ENVIRONMENT AND RUNTIME
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
LOGS_DIR=logs

# ------------------------------------------------------------------------------
# SERVER CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
AUTH_API_PORT=8003

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/next_watch

# ------------------------------------------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8001,http://localhost:8002

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SETTINGS
# ------------------------------------------------------------------------------
# CRITICAL: These must match across all services in the platform
JWT_SECRET=change_this_in_production_very_important
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Advanced JWT Configuration (Optional)
# JWT_JWK={"kty":"oct","k":"your-jwk-key-here"}
JWT_JWK_ROTATION_INTERVAL=86400

# ------------------------------------------------------------------------------
# SECURITY SETTINGS
# ------------------------------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1,auth-api

# Password Hashing Configuration
PASSWORD_HASH_ROUNDS=12

# Login Security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=60

# ------------------------------------------------------------------------------
# PERFORMANCE MONITORING
# ------------------------------------------------------------------------------
ENABLE_PERFORMANCE_METRICS=false

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ------------------------------------------------------------------------------
# EMAIL CONFIGURATION (Optional - for password reset, verification)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=noreply@nextwatch.com

# ------------------------------------------------------------------------------
# DEVELOPMENT OVERRIDES
# ------------------------------------------------------------------------------
# Uncomment these for development
# DEBUG=true
# LOG_LEVEL=DEBUG
# JWT_SECRET=dev-secret-not-for-production

# ------------------------------------------------------------------------------
# PRODUCTION SECURITY CHECKLIST
# ------------------------------------------------------------------------------
# Before deploying to production, ensure:
# 1. ENVIRONMENT=production
# 2. DEBUG=false
# 3. Strong JWT_SECRET (32+ random characters)
# 4. Strong DATABASE_URL with secure credentials
# 5. Restricted CORS_ORIGINS (no wildcards)
# 6. Appropriate ALLOWED_HOSTS
# 7. ENABLE_PERFORMANCE_METRICS=true (if monitoring is set up)
